[user]
	email = antoniofbove@gmail.com
	name = above
[core]
	; FIXME: 
	; excludesfile = "$HOME/.gitignore_global"
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig.work
[init]
	defaultBranch = main
[rebase]
	autostash = true
[pull]
	rebase = true
[alias]
	co = checkout
	st = status
	cp = cherry-pick
  wt = worktree
  lol = log --pretty=format:'%C(yellow)%h %Cred%an%Cgreen%d %Creset%s'
  gol = log --graph --pretty=format:'%C(yellow)%h %Cred%ad %Cblue%an%Cgreen%d %Creset%s' --date=short
  b = branch
  cb = branch --show-current
[core]
	editor = nvim -f
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[help]
	autocorrect = prompt
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
