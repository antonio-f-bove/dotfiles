[user]
	email = antoniofbove@gmail.com
	name = above
[core]
	; FIXME: 
	; excludesfile = "$HOME/.gitignore_global"
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig.work
[init]
	defaultBranch = main
[rebase]
	autostash = true
[pull]
	rebase = true
[above]
	mainBranch = main
[alias]
	co = checkout
	st = status
	cp = cherry-pick
  wt = worktree
  lol = log --graph --pretty=format:'%C(yellow)%h %Cred%ad %Cblue%an%Cgreen%d %Creset%s' --date=short
  ; gol uses shell alias (`!`). Builds ref list dynamically: always HEAD,
  ; plus origin/<current-branch> and origin/<main-branch> if those refs exist.
  ; Main branch comes from `above.mainBranch`, defaulting to `main`. Extra args pass through.
  gol = "!f() { refs=HEAD; b=$(git branch --show-current); mb=$(git config --get above.mainBranch || echo main); if [ -n \"$b\" ] && git show-ref --verify --quiet \"refs/remotes/origin/$b\"; then refs=\"$refs origin/$b\"; fi; if [ -n \"$mb\" ] && [ \"$mb\" != \"$b\" ] && git show-ref --verify --quiet \"refs/remotes/origin/$mb\"; then refs=\"$refs origin/$mb\"; fi; git log --graph --pretty=format:'%C(yellow)%h %Cred%ad %Cblue%an%Cgreen%d %Creset%s' --date=short $refs \"$@\"; }; f"
  b = branch
  cb = branch --show-current
[core]
	editor = nvim -f
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[help]
	autocorrect = prompt
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
